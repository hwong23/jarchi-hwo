/*
 * MTX-matrixfromview - Generador de Matriz desde Vista ArchiMate
 *
 * Proposito:
 * Derivar una matriz de interacciones entre tipos de elementos (filas y columnas)
 * a partir de una vista ArchiMate seleccionada, y exportarla en XLSX, Markdown o CSV.
 *
 * Rutina principal:
 * 1) Carga configuracion y librerias auxiliares.
 * 2) Normaliza el formato de salida (xlsx|md|csv).
 * 3) Construye la matriz leyendo elementos y relaciones desde la vista seleccionada.
 * 4) Genera nombre base de salida con timestamp.
 * 5) Exporta segun formato: hoja Excel, tabla Markdown o archivo CSV.
 *
 * Entradas:
 * - Vista ArchiMate seleccionada en el modelo (selection).
 * - cfg_mdOptions.columnType: tipo(s) de elemento para columnas.
 * - cfg_mdOptions.rowType: tipo(s) de elemento para filas.
 * - cfg_mdOptions.cellSeparator: separador interno cuando hay varias relaciones.
 * - cfg_mdOptions.outputFormat: formato de salida (xlsx, md o csv).
 * - cfg_mdOptions.userPath: ruta base para guardar archivos.
 * - cfg_mdOptions.tabName: nombre de hoja para XLSX.
 * - cfg_mdOptions.csvDelimiter y cfg_mdOptions.csvLineBreak: parametros CSV.
 *
 * Salidas:
 * - Archivo de matriz en la carpeta indicada por userPath:
 *   - XLSX: archimate_matrices-<timestamp>.xlsx
 *   - MD:   archimate_matrices-<timestamp>.md
 *   - CSV:  archimate_matrices-<timestamp>.csv
 * - Mensajes de estado en consola.
 *
 * Notas:
 * - Si no hay una vista ArchiMate seleccionada, el script lanza error y se detiene.
 * - Los tipos de relacion pueden mapearse a codigos cortos (ej. AG, SV, R).
 */

load(__DIR__ + "lib/mb-matrixfrommodel-cfg.js");
load(__DIR__ + "lib/devdocslib.js");

debug = cfg_mdOptions.debug;

var outputFormat = normalizeOutputFormat(cfg_mdOptions.outputFormat);

if (outputFormat === "xlsx") {
  load(__DIR__ + "lib/jszip-101.js");
  load(__DIR__ + "lib/myexcel.js");
}

var matrix = buildMatrix(
  cfg_mdOptions.columnType,
  cfg_mdOptions.rowType,
  cfg_mdOptions.cellSeparator
);

var baseOutputName = cfg_mdOptions.userPath + "/archimate_matrices-" + formatShortTimestamp();

if (outputFormat === "md") {
  saveMarkdown(matrixToMarkdown(matrix.headers, matrix.rows), baseOutputName + ".md");
} else if (outputFormat === "csv") {
  saveCsv(
    matrixToCSV(
      matrix.headers,
      matrix.rows,
      cfg_mdOptions.csvDelimiter || ",",
      cfg_mdOptions.csvLineBreak || "\r\n"
    ),
    baseOutputName + ".csv"
  );
} else {
  var sheet = prepareSheet();
  writeMatrixToSheet(sheet, matrix.headers, matrix.rows, cfg_mdOptions.tabName);
  saveSheet(sheet, baseOutputName + ".xlsx");
}

//----------------------------------------------------
function normalizeOutputFormat(format)
{
  var value = String(format || "xlsx").toLowerCase();
  return (value === "md" || value === "csv") ? value : "xlsx";
}

//----------------------------------------------------
function prepareSheet()
{
  var spreadsheet = $JExcel.new("Calibri 12 #333333");
  return spreadsheet;
}

//----------------------------------------------------
function saveSheet(sheet,outputFilename)
{
  sheet.generate(outputFilename);
  console.log("XLSX matrix saved to: " + outputFilename);
}

//----------------------------------------------------
function saveMarkdown(content, outputFilename)
{
  $.fs.writeFile(outputFilename, content, "UTF-8");
  console.log("Markdown matrix saved to: " + outputFilename);
}

//----------------------------------------------------
function saveCsv(content, outputFilename)
{
  var bom = "\uFEFF";
  $.fs.writeFile(outputFilename, bom + content, "UTF-8");
  console.log("CSV matrix saved to: " + outputFilename);
}

//----------------------------------------------------
function formatShortTimestamp()
{
  var now = new Date();

  function pad(value)
  {
    return (value < 10 ? "0" : "") + value;
  }

  return String(now.getFullYear()).substring(2) +
    pad(now.getMonth() + 1) +
    pad(now.getDate()) + "-" +
    pad(now.getHours()) +
    pad(now.getMinutes());
}

//----------------------------------------------------
function parseElementTypes(elementTypes)
{
  if (Array.isArray(elementTypes)) {
    return elementTypes;
  }

  return String(elementTypes)
    .split(",")
    .map(function(typeName) {
      return typeName.trim();
    })
    .filter(function(typeName) {
      return typeName.length > 0;
    });
}

//----------------------------------------------------
function buildMatrix(columnType,rowType,cellSeparator)
{
  var rowTypes = parseElementTypes(rowType);
  var columnTypes = parseElementTypes(columnType);
  var legend = {name: rowTypes.join(", ") + "/" + columnTypes.join(", ")};
  var headers = [legend];

  var theView = $(selection).filter("archimate-diagram-model").first();
  if (!theView) {
    throw "Please select one ArchiMate view before running this script";
  }
  debug ? console.log(theView) : true;

  columnTypes.forEach(function(currentColumnType) {
    $(theView).find(currentColumnType).forEach(function(e) {
      headers.push(e);
    });
  });

  var rows = [];

  rowTypes.forEach(function(currentRowType) {
    $(theView).find(currentRowType).forEach(function(e) {
      var rowCells = [e.name];
      var relations = $(e).rels();

      for (var i = 1; i < headers.length; i++) {
        var cellText = "";
        for (var j = 0; j < relations.length; j++) {
          var rel = relations[j];
          if ((rel.source.id == e.id) && (rel.target.id == headers[i].id)) {
            var relText = devdoc_typeMappingsRelacionesCorta[rel.type] || rel.type;
            cellText = cellText.length === 0 ? relText : relText + cellSeparator + cellText;
            debug ? console.log("rel:", rel.type, devdoc_typeMappingsRelacionesCorta[rel.type]) : true;
          }
        }
        rowCells.push(cellText);
      }

      rows.push(rowCells);
    });
  });

  return {
    headers: headers,
    rows: rows
  };
}

//----------------------------------------------------
function writeMatrixToSheet(sheet,headers,rows,tabName)
{
  sheet.set({ sheet: 0, value: tabName });

  var formatHeader = sheet.addStyle({
    fill: "#dddddd",
    border: "thin, thin, thin, thin #555555",
    font: "Calibri 12 #000000 B"
  });

  for (var i = 0; i < headers.length; i++) {
    sheet.set(0, i, 0, headers[i].name, formatHeader);
    sheet.set(0, i, undefined, "auto");
  }

  for (var r = 0; r < rows.length; r++) {
    for (var c = 0; c < rows[r].length; c++) {
      sheet.set(0, c, r + 1, rows[r][c]);
    }
  }
}

//----------------------------------------------------
function matrixToMarkdown(headers, rows)
{
  var lines = [];

  var headerRow = "|";
  for (var i = 0; i < headers.length; i++) {
    headerRow += " " + escapeMarkdownCell(headers[i].name) + " |";
  }
  lines.push(headerRow);

  var divider = "|";
  for (var j = 0; j < headers.length; j++) {
    divider += " --- |";
  }
  lines.push(divider);

  for (var r = 0; r < rows.length; r++) {
    var rowLine = "|";
    for (var c = 0; c < rows[r].length; c++) {
      rowLine += " " + escapeMarkdownCell(rows[r][c]) + " |";
    }
    lines.push(rowLine);
  }

  return lines.join("\n") + "\n";
}

//----------------------------------------------------
function matrixToCSV(headers, rows, delimiter, lineBreak)
{
  var lines = [];

  lines.push(headers.map(function(header) {
    return escapeCSVCell(header.name, delimiter);
  }).join(delimiter));

  for (var r = 0; r < rows.length; r++) {
    lines.push(rows[r].map(function(cell) {
      return escapeCSVCell(cell, delimiter);
    }).join(delimiter));
  }

  return lines.join(lineBreak) + lineBreak;
}

//----------------------------------------------------
function escapeMarkdownCell(value)
{
  if (value === null || value === undefined) {
    return "";
  }

  return String(value)
    .replace(/\|/g, "\\|")
    .replace(/\r\n|\n|\r/g, "<br>");
}

//----------------------------------------------------
function escapeCSVCell(value, delimiter)
{
  if (value === null || value === undefined) {
    return "";
  }

  var text = String(value)
    .replace(/\r\n/g, "\n")
    .replace(/\r/g, "\n")
    .replace(/"/g, '""');

  if (text.indexOf(delimiter) !== -1 || text.indexOf("\n") !== -1 || text.indexOf('"') !== -1) {
    return '"' + text + '"';
  }

  return text;
}
