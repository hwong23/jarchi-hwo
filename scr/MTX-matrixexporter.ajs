/**
 * jArchi - Custom Relationship Matrix Exporter
 * Formats: Source Elements (Rows) vs Target Elements (Columns)
 */

console.show();
console.clear();

// --- CONFIGURATION ---
// Change these selectors to the ArchiMate types you want to map
var ROW_ELEMENT_TYPE = "business-object";     // e.g., "business-process", "capability"
var COL_ELEMENT_TYPE = "application-component"; // e.g., "application-component", "business-role"
var CSV_DELIMITER = ";"; // Set to ";" or "|" if needed
var CSV_LINE_BREAK = "\r\n"; // Use CRLF for better Excel compatibility
var BOM = "\uFEFF"; // UTF-8 BOM to help Excel detect Unicode correctly
var MATRIX_FILE_PATH = "/Users/hwo/Downloads/archi_matrix.csv"; // Change to your preferred file path

console.log("Generating Matrix: " + ROW_ELEMENT_TYPE + " vs " + COL_ELEMENT_TYPE);

// 1. Fetch elements from the model
var rows = $(ROW_ELEMENT_TYPE);
var cols = $(COL_ELEMENT_TYPE);

if(rows.size() === 0 || cols.size() === 0) {
    console.log("Error: No elements found for the selected types. Check your configuration.");
    exit();
}

// 2. Build the CSV Header (Top Row)
var csvContent = "Source / Target";
cols.each(function(colElement) {
    csvContent += CSV_DELIMITER + sanitizeCSV(colElement.name);
});
csvContent += CSV_LINE_BREAK;

// 3. Build the Matrix Rows
rows.each(function(rowElement) {
    var line = sanitizeCSV(rowElement.name);
    
    cols.each(function(colElement) {
        // Find relationships originating from rowElement and ending at colElement
        var rels = $(rowElement).rels().filter(function(rel) {
            return rel.target.id === colElement.id || rel.source.id === colElement.id;
        });
        
        if(rels.size() > 0) {
            // If connected, put the relationship type(s) in the cell
            var relTypes = [];
            rels.each(function(r) {
                relTypes.push(r.type);
            });
            line += CSV_DELIMITER + sanitizeCSV(relTypes.join("|"));
        } else {
            // Empty cell if no relationship exists
            line += CSV_DELIMITER;
        }
    });
    
    csvContent += line + CSV_LINE_BREAK;
});

// 4. Save to File
try {
    $.fs.writeFile(MATRIX_FILE_PATH, BOM + csvContent, "UTF-8");
    console.log("Success! Matrix exported to: " + MATRIX_FILE_PATH);
} catch(err) {
    console.log("Could not write file. Outputting raw CSV to console instead:\n\n");
    console.log(csvContent);
}

// Helper to escape delimiter, newlines and quotes in names
function sanitizeCSV(text) {
    if (!text) return "";
    var sanitized = String(text).replace(/\r\n/g, "\n").replace(/\r/g, "\n").replace(/"/g, '""');
    if (sanitized.indexOf(CSV_DELIMITER) !== -1 || sanitized.indexOf("\n") !== -1 || sanitized.indexOf('"') !== -1) {
        sanitized = '"' + sanitized + '"';
    }
    return sanitized;
}
