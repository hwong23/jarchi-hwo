/*
 * jArchi - Exportador de Matriz de Relaciones
 *
 * Propósito:
 * Generar una matriz de relaciones entre dos tipos de elementos ArchiMate.
 * La salida se controla mediante lib/mb-matrixfrommodel-cfg.js y puede ser
 * CSV, Markdown o XLSX.
 */

load(__DIR__ + "lib/mb-matrixfrommodel-cfg.js");

debug = cfg_mdOptions.debug;

var outputFormat = normalizeOutputFormat(cfg_mdOptions.outputFormat);

if (outputFormat === "xlsx") {
  load(__DIR__ + "lib/jszip-101.js");
  load(__DIR__ + "lib/myexcel.js");
}

var typeMappingsRelaciones = {
  "access-relationship": "AC",
  "composition-relationship": "CO",
  "flow-relationship": "F",
  "realization-relationship": "R",
  "assignment-relationship": "AG",
  "serving-relationship": "SV",
  "association-relationship": "AS",
  "aggregation-relationship": "AG",
  "influence-relationship": "I",
  "specialization-relationship": "S"
};

console.show();
console.clear();
console.log("Generating matrix: " + cfg_mdOptions.rowType + " vs " + cfg_mdOptions.columnType + " -> " + outputFormat);

var matrix = buildMatrix(
  cfg_mdOptions.columnType,
  cfg_mdOptions.rowType,
  cfg_mdOptions.cellSeparator
);

var baseOutputName = cfg_mdOptions.userPath + "/matrices_reporter-" + formatShortTimestamp();

if (outputFormat === "md") {
  saveText(matrixToMarkdown(matrix.headers, matrix.rows), baseOutputName + ".md", "Markdown");
} else if (outputFormat === "csv") {
  saveText(
    matrixToCSV(
      matrix.headers,
      matrix.rows,
      cfg_mdOptions.csvDelimiter || ";",
      cfg_mdOptions.csvLineBreak || "\r\n"
    ),
    baseOutputName + ".csv",
    "CSV"
  );
} else {
  var sheet = prepareSheet();
  writeMatrixToSheet(sheet, matrix.headers, matrix.rows, cfg_mdOptions.tabName);
  saveSheet(sheet, baseOutputName + ".xlsx");
}

//----------------------------------------------------
function normalizeOutputFormat(format)
{
  var value = String(format || "csv").toLowerCase();
  return (value === "csv" || value === "md" || value === "xlsx") ? value : "csv";
}

//----------------------------------------------------
function parseElementTypes(elementTypes)
{
  if (Array.isArray(elementTypes)) {
    return elementTypes;
  }

  return String(elementTypes)
    .split(",")
    .map(function(typeName) {
      return typeName.trim();
    })
    .filter(function(typeName) {
      return typeName.length > 0;
    });
}

//----------------------------------------------------
function formatShortTimestamp()
{
  var now = new Date();

  function pad(value)
  {
    return (value < 10 ? "0" : "") + value;
  }

  return String(now.getFullYear()).substring(2) +
    pad(now.getMonth() + 1) +
    pad(now.getDate()) + "-" +
    pad(now.getHours()) +
    pad(now.getMinutes());
}

//----------------------------------------------------
function prepareSheet()
{
  return $JExcel.new("Calibri 12 #333333");
}

//----------------------------------------------------
function saveSheet(sheet, outputFilename)
{
  sheet.generate(outputFilename);
  console.log("XLSX matrix saved to: " + outputFilename);
}

//----------------------------------------------------
function saveText(content, outputFilename, label)
{
  var bom = outputFilename.toLowerCase().indexOf(".csv") !== -1 ? "\uFEFF" : "";
  $.fs.writeFile(outputFilename, bom + content, "UTF-8");
  console.log(label + " matrix saved to: " + outputFilename);
}

//----------------------------------------------------
function buildMatrix(columnType, rowType, cellSeparator)
{
  var rowTypes = parseElementTypes(rowType);
  var columnTypes = parseElementTypes(columnType);
  var legend = { name: rowTypes.join(", ") + "/" + columnTypes.join(", ") };
  var headers = [legend];

  columnTypes.forEach(function(currentColumnType) {
    $(currentColumnType).forEach(function(element) {
      headers.push(element);
    });
  });

  var rows = [];

  rowTypes.forEach(function(currentRowType) {
    $(currentRowType).forEach(function(element) {
      var rowCells = [element.name];
      var relations = $(element).rels();

      for (var i = 1; i < headers.length; i++) {
        var cellText = "";
        for (var j = 0; j < relations.length; j++) {
          var rel = relations[j];
          if ((rel.source.id == element.id) && (rel.target.id == headers[i].id)) {
            var relText = typeMappingsRelaciones[rel.type] || rel.type;
            cellText = cellText.length === 0 ? relText : relText + cellSeparator + cellText;
          }
        }
        rowCells.push(cellText);
      }

      rows.push(rowCells);
    });
  });

  return {
    headers: headers,
    rows: rows
  };
}

//----------------------------------------------------
function writeMatrixToSheet(sheet, headers, rows, tabName)
{
  sheet.set({ sheet: 0, value: tabName });

  var formatHeader = sheet.addStyle({
    fill: "#dddddd",
    border: "thin, thin, thin, thin #555555",
    font: "Calibri 12 #000000 B"
  });

  for (var i = 0; i < headers.length; i++) {
    sheet.set(0, i, 0, headers[i].name, formatHeader);
    sheet.set(0, i, undefined, "auto");
  }

  for (var r = 0; r < rows.length; r++) {
    for (var c = 0; c < rows[r].length; c++) {
      sheet.set(0, c, r + 1, rows[r][c]);
    }
  }
}

//----------------------------------------------------
function matrixToMarkdown(headers, rows)
{
  var lines = [];

  lines.push(headers.map(function(header) {
    return "| " + escapeMarkdownCell(header.name) + " ";
  }).join("") + "|");

  lines.push(headers.map(function() {
    return "| --- ";
  }).join("") + "|");

  for (var r = 0; r < rows.length; r++) {
    lines.push(rows[r].map(function(cell) {
      return "| " + escapeMarkdownCell(cell) + " ";
    }).join("") + "|");
  }

  return lines.join("\n") + "\n";
}

//----------------------------------------------------
function matrixToCSV(headers, rows, delimiter, lineBreak)
{
  var lines = [];

  lines.push(headers.map(function(header) {
    return escapeCSVCell(header.name, delimiter);
  }).join(delimiter));

  for (var r = 0; r < rows.length; r++) {
    lines.push(rows[r].map(function(cell) {
      return escapeCSVCell(cell, delimiter);
    }).join(delimiter));
  }

  return lines.join(lineBreak) + lineBreak;
}

//----------------------------------------------------
function escapeMarkdownCell(value)
{
  if (value === null || value === undefined) {
    return "";
  }

  return String(value)
    .replace(/\|/g, "\\|")
    .replace(/\r\n|\n|\r/g, "<br>");
}

//----------------------------------------------------
function escapeCSVCell(value, delimiter)
{
  if (value === null || value === undefined) {
    return "";
  }

  var text = String(value)
    .replace(/\r\n/g, "\n")
    .replace(/\r/g, "\n")
    .replace(/"/g, '""');

  if (text.indexOf(delimiter) !== -1 || text.indexOf("\n") !== -1 || text.indexOf('"') !== -1) {
    return '"' + text + '"';
  }

  return text;
}
